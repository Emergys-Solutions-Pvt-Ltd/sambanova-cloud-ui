# ---------------------------------------------------------------------------
# Public (inlined into the browser bundle at build time)
# ---------------------------------------------------------------------------

# Base URL of the SambaNova Cloud API. With mocks on, MSW intercepts requests
# to this URL, so a relative path works for local development.
NEXT_PUBLIC_API_BASE_URL=/api

# "true" starts the MSW browser worker and serves every API call from
# src/mocks. Set to "false" once the real backend is available.
NEXT_PUBLIC_USE_MOCKS=true

# "true" shows the TanStack Query devtools button in development. Off by default.
NEXT_PUBLIC_QUERY_DEVTOOLS=false

# Comma-separated routes to switch off, e.g. /playground,/api-keys,/settings. A route also
# disables everything beneath it. Opening one (typing the URL or following a link) shows the
# 404 page; links and buttons keep their normal look. Read at build time: restart
# `npm run dev` (or redeploy) after changing it. Leave empty to enable every route.
NEXT_PUBLIC_DISABLED_ROUTES=

# "true" shows the System / Light / Dark theme switcher (the signed-out sidebar footer and the
# account menu). Off by default: the app is dark and has no theme options (a saved Light or System
# choice is ignored, not deleted). Read at build time: restart `npm run dev` (or redeploy) after changing it.
NEXT_PUBLIC_ENABLE_THEME_SWITCHER=false

# ---------------------------------------------------------------------------
# Auth0 (server only, placeholders: not used until the auth integration)
# ---------------------------------------------------------------------------
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# 32-byte hex string, e.g. `openssl rand -hex 32`
AUTH0_SECRET=
APP_BASE_URL=http://localhost:3000
