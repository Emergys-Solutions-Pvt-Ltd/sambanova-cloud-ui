# ---------------------------------------------------------------------------
# Public (inlined into the browser bundle at build time)
# ---------------------------------------------------------------------------

# Base URL of the SambaNova Cloud API. With mocks on, MSW intercepts requests
# to this URL, so a relative path works for local development.
NEXT_PUBLIC_API_BASE_URL=/api

# "true" starts the MSW browser worker and serves every API call from
# src/mocks. Set to "false" once the real backend is available.
NEXT_PUBLIC_USE_MOCKS=true

# ---------------------------------------------------------------------------
# Auth0 (server only, placeholders: not used until the auth integration)
# ---------------------------------------------------------------------------
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# 32-byte hex string, e.g. `openssl rand -hex 32`
AUTH0_SECRET=
APP_BASE_URL=http://localhost:3000
